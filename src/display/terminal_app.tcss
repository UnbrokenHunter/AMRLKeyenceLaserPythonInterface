/* file: src/display/terminal_app.tcss */

Screen {
    layout: vertical;
    background: #101418;
}

#main {
    height: 1fr;
    padding: 1;
}

#top-row {
    height: 1fr;
}

.panel {
    border: round #4b6475;
    padding: 1;
    margin: 0 1 1 0;
    background: #151b21;
}

.panel-title-row {
    height: 1;
    margin-bottom: 1;
}

.panel-title {
    width: auto;
    text-style: bold;
    color: #d7f3ff;
}

.panel-title-port {
    width: 1fr;
    color: #7f8c94;
    margin-left: 1;
}

.status-line {
    height: 1;
    margin-bottom: 1;
}

.field-label {
    color: #9fb6c3;
    margin-top: 1;
}

#spc-received-panel,
#keyence-sent-panel {
    width: 1fr;
    min-height: 16;
}

#status-column {
    width: 55;
}

RichLog {
    height: 1fr;
    border: tall #2d3b44;
    background: #0e1114;
}

.coms-log {
    text-style: dim;
}

#continuous-row {
    height: auto;
}

#continuous-panel {
    width: 1fr;
    height: 0;
    display: none;
}

#continuous-panel.visible {
    height: 12;
    display: block;
}

#continuous-status-spacer {
    width: 55;
    height: 0;
}

#controls {
    height: 5;
    border: round #4b6475;
    padding: 0 1;
    background: #151b21;
    align: left middle;
}

.control-bar {
    height: 5;
    align: left middle;
}

.control-button {
    width: auto;
    min-width: 8;
    height: 3;
    margin-right: 1;
    content-align: center middle;
}

.toggle-button {
    min-width: 19;
    text-style: bold;
}

.toggle-on {
    background: #1d6f42;
    color: #ffffff;
}

.toggle-off {
    background: #3a3f44;
    color: #c7d0d8;
}

#misc-state-panel {
    height: auto;
}

#misc-state {
    height: auto;
    color: #b8c7d0;
}

/* Coms panel title row */

.panel-title-row {
    height: 1;
    margin-bottom: 1;
    align: left middle;
}

.panel-title {
    width: auto;
    text-style: bold;
    color: #d7f3ff;
    content-align: left middle;
}

.panel-title-port {
    width: 1fr;
    color: #7f8c94;
    margin-left: 1;
    content-align: left middle;
}

/* Tiny TX/RX filters */

.coms-filter-mini {
    width: 4;
    height: 1;
    margin-left: 1;
    content-align: center middle;
    text-style: bold;
}

.coms-filter-mini.enabled {
    background: #1d6f42;
    color: #ffffff;
}

.coms-filter-mini.disabled {
    background: #3a3f44;
    color: #808890;
}