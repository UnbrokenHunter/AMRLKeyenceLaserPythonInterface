Screen {
    layout: vertical;
    background: #101418;
}

#main {
    height: 1fr;
    padding: 1;
}

/* Main layout */

#content-row {
    height: 1fr;
}

#left-column {
    width: 1fr;
    height: 1fr;
}

#coms-row {
    height: 1fr;
}

#status-column {
    width: 55;
    height: 1fr;
}

/* Shared panel styling */

.panel {
    border: round #4b6475;
    padding: 1;
    margin: 0 1 1 0;
    background: #151b21;
}

.panel-title-row {
    height: 1;
    margin-bottom: 1;
    align: left middle;
}

.panel-title {
    width: auto;
    text-style: bold;
    color: #d7f3ff;
    content-align: left middle;
}

.panel-title-port {
    width: 1fr;
    color: #7f8c94;
    margin-left: 1;
    content-align: left middle;
}

/* Status panels */

.status-line {
    height: 1;
    margin-bottom: 1;
}

.field-label {
    color: #9fb6c3;
    margin-top: 1;
}

#misc-state-panel {
    height: auto;
}

#misc-state {
    height: auto;
    color: #b8c7d0;
}

/* SPC / Keyence coms panels */

#spc-coms-panel,
#keyence-coms-panel {
    width: 1fr;
    height: 1fr;
    min-height: 16;
}

RichLog {
    height: 1fr;
    border: tall #2d3b44;
    background: #0e1114;
}

.coms-log {
    text-style: dim;
}

/* Tiny TX/RX filters */

.coms-filter-mini {
    width: 4;
    height: 1;
    margin-left: 1;
    content-align: center middle;
    text-style: bold;
}

.coms-filter-mini.enabled {
    background: #1d6f42;
    color: #ffffff;
}

.coms-filter-mini.disabled {
    background: #3a3f44;
    color: #808890;
}

/* Raw stream + live graph area */

#continuous-panel {
    width: 1fr;
    height: 0;
    display: none;
}

#continuous-panel.visible {
    height: 18;
    display: block;
}

.continuous-half-panel {
    width: 1fr;
    height: 1fr;
}

#raw-keyence-stream-panel {
    width: 1fr;
    height: 1fr;
    padding-right: 1;
    border-right: solid #2d3b44;
}

.height-graph-panel {
    width: 1fr;
    height: 1fr;
    padding-left: 1;
}

.height-current-value {
    height: 1;
    color: #d7f3ff;
    text-style: bold;
    margin-bottom: 1;
}

#height-graph {
    height: 1fr;
    color: #b8c7d0;
    overflow: hidden;
}

/* Bottom control bar */

#controls {
    width: 1fr;
    height: 5;
    border: round #4b6475;
    padding: 0 1;
    background: #151b21;
    align: left middle;
}

.control-bar {
    width: 1fr;
    height: 5;
    align: left middle;
}

.control-button {
    width: auto;
    min-width: 8;
    height: 3;
    margin-right: 1;
    content-align: center middle;
}

.toggle-button {
    min-width: 19;
    text-style: bold;
}

.toggle-on {
    background: #1d6f42;
    color: #ffffff;
}

.toggle-off {
    background: #3a3f44;
    color: #c7d0d8;
}